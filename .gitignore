# ==============================================================================
# .gitignore 
# ==============================================================================

# Local config — copy from config.example.sh, edit, never commit
config/config.sh

# Pipeline working dirs and outputs
work/
vcfs/
happy_out/
fastq/

# Large bioinformatics artefacts (generated locally, often huge)
*.bam
*.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bcf
*.bcf.csi

# Reference indexes (rebuild on each machine)
*.fai
*.dict
*.bwt.2bit.64
*.0123
*.amb
*.ann
*.pac
*.bwt
*.sa
*.sdf/
*.gzi

# Conda / Python
.conda/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs 
*.log
